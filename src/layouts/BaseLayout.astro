---
import SEOHead from '../components/common/SEOHead.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import BackToTop from '../components/common/BackToTop.astro';
import { getPath } from '../utils/links';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  jsonLd?: object;
  canonical?: string;
}

const { title, description, image, type, publishedDate, jsonLd, canonical } = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      type={type}
      publishedDate={publishedDate}
      jsonLd={jsonLd}
      canonical={canonical}
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-ink text-base antialiased font-body">
    <!-- Skip Navigation Link — Requirement 18.2 -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-white focus:px-4 focus:py-2 focus:rounded-md focus:shadow-md focus:text-primary-700 focus:font-medium focus:outline-2 focus:outline-primary-600"
    >
      Langsung ke konten
    </a>

    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <BackToTop />
    <Footer />

    <!-- Mobile Bottom Tab Bar (visible on mobile only) -->
    <nav class="lg:hidden fixed bottom-0 left-0 right-0 z-40 grid grid-cols-4 border-t border-line bg-white" aria-label="Navigasi utama mobile" data-pagefind-ignore>
      <a href={getPath('/')} class="flex flex-col items-center justify-center gap-1 py-2.5 text-[10px] text-muted hover:text-primary-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
        Beranda
      </a>
      <a href={getPath('/pengumuman')} class="flex flex-col items-center justify-center gap-1 py-2.5 text-[10px] text-muted hover:text-primary-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z" /></svg>
        Pengumuman
      </a>
      <a href={getPath('/berita')} class="flex flex-col items-center justify-center gap-1 py-2.5 text-[10px] text-muted hover:text-primary-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" /></svg>
        Berita
      </a>
      <a href={getPath('/umkm')} class="flex flex-col items-center justify-center gap-1 py-2.5 text-[10px] text-muted hover:text-primary-700 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        Belanja
      </a>
    </nav>

    <!-- Bottom padding spacer for mobile to prevent content being hidden behind bottom nav -->
    <div class="lg:hidden h-16"></div>
  </body>
</html>
