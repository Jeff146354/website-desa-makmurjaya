---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/beranda/HeroSection.astro';
import BeritaTerbaru from '../components/beranda/BeritaTerbaru.astro';
import PengumumanTerbaru from '../components/beranda/PengumumanTerbaru.astro';
import HighlightWisata from '../components/beranda/HighlightWisata.astro';
import HighlightUMKM from '../components/beranda/HighlightUMKM.astro';
import { getPath } from '../utils/links';
import situs from '../data/situs.json';

const seoTitle = 'Beranda — Desa Makmurjaya';
const seoDescription =
  'Website resmi Desa Makmurjaya. Informasi berita desa, pengumuman, wisata, UMKM, dan layanan pemerintahan desa.';

const siteUrl = import.meta.env.SITE ?? 'https://desamakmurjaya.id';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'GovernmentOrganization',
  name: 'Pemerintah Desa Makmurjaya',
  url: siteUrl,
  description: seoDescription,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Makmurjaya',
    addressRegion: 'Jawa Barat',
    addressCountry: 'ID',
  },
};
---

<BaseLayout title={seoTitle} description={seoDescription} jsonLd={jsonLd}>
  <!-- Hero Section -->
  <HeroSection
    tagline={situs.tagline_hero}
    namaDesaSubtitle={situs.nama_desa}
  />

  <!-- Jelajahi Desa (Quick Nav) -->
  <section class="px-4 md:px-8 py-10 md:py-12 border-b border-line" aria-labelledby="jelajahi-heading">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-6">
        <p class="eyebrow mb-1">Navigasi Cepat</p>
        <h2 id="jelajahi-heading" class="h-section">Jelajahi Desa</h2>
        <p class="sub-text mt-1">Akses semua layanan informasi Desa Makmurjaya dalam satu portal.</p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        <a href={getPath('/profil/sejarah')} class="card p-4 md:p-6 flex flex-col items-center gap-2 md:gap-3 hover:shadow-elevated transition text-center">
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-primary-50 flex items-center justify-center">
            <svg class="w-6 h-6 md:w-7 md:h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" /></svg>
          </div>
          <div class="font-display font-semibold text-[13px] md:text-[14px] text-ink">Profil Desa</div>
          <p class="sub-text text-[11px] md:text-[12px] hidden md:block">Visi, misi, sejarah, dan peta</p>
        </a>
        <a href={getPath('/infografis')} class="card p-4 md:p-6 flex flex-col items-center gap-2 md:gap-3 hover:shadow-elevated transition text-center">
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-primary-50 flex items-center justify-center">
            <svg class="w-6 h-6 md:w-7 md:h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
          </div>
          <div class="font-display font-semibold text-[13px] md:text-[14px] text-ink">Infografis</div>
          <p class="sub-text text-[11px] md:text-[12px] hidden md:block">Penduduk, APBDes, IDM, SDGs</p>
        </a>
        <a href={getPath('/pemerintahan')} class="card p-4 md:p-6 flex flex-col items-center gap-2 md:gap-3 hover:shadow-elevated transition text-center">
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-primary-50 flex items-center justify-center">
            <svg class="w-6 h-6 md:w-7 md:h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <div class="font-display font-semibold text-[13px] md:text-[14px] text-ink">Pemerintahan</div>
          <p class="sub-text text-[11px] md:text-[12px] hidden md:block">Struktur organisasi desa</p>
        </a>
        <a href={getPath('/umkm')} class="card p-4 md:p-6 flex flex-col items-center gap-2 md:gap-3 hover:shadow-elevated transition text-center">
          <div class="w-12 h-12 md:w-14 md:h-14 rounded-2xl bg-primary-50 flex items-center justify-center">
            <svg class="w-6 h-6 md:w-7 md:h-7 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
          </div>
          <div class="font-display font-semibold text-[13px] md:text-[14px] text-ink">Belanja</div>
          <p class="sub-text text-[11px] md:text-[12px] hidden md:block">Produk UMKM warga desa</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Berita Terbaru -->
  <section class="px-4 md:px-8 py-10 md:py-12 border-b border-line" aria-labelledby="berita-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-5">
        <h2 id="berita-heading" class="h-section">Berita Desa</h2>
        <a href={getPath('/berita')} class="btn-ghost text-[13px]">
          Lihat semua
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <BeritaTerbaru />
    </div>
  </section>

  <!-- Pengumuman Terbaru -->
  <section class="px-4 md:px-8 py-10 md:py-12 border-b border-line section-alt" aria-labelledby="pengumuman-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-5">
        <h2 id="pengumuman-heading" class="h-section">Pengumuman &amp; Agenda</h2>
        <a href={getPath('/pengumuman')} class="btn-ghost text-[13px]">
          Lihat semua
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <PengumumanTerbaru />
    </div>
  </section>

  <!-- Highlight Wisata -->
  <section class="px-4 md:px-8 py-10 md:py-12 border-b border-line" aria-labelledby="wisata-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-5">
        <h2 id="wisata-heading" class="h-section">Wisata Desa</h2>
        <a href={getPath('/wisata')} class="btn-ghost text-[13px]">
          Lihat semua
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <HighlightWisata />
    </div>
  </section>

  <!-- Highlight UMKM -->
  <section class="px-4 md:px-8 py-10 md:py-12 border-b border-line section-alt" aria-labelledby="umkm-heading">
    <div class="max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-5">
        <div>
          <p class="eyebrow mb-1">UMKM Desa</p>
          <h2 id="umkm-heading" class="h-section">Beli Dari Desa</h2>
        </div>
        <a href={getPath('/umkm')} class="btn-ghost text-[13px]">
          Lihat semua
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
      <HighlightUMKM />
    </div>
  </section>
</BaseLayout>
