---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PetaKantor from '../../components/kontak/PetaKantor.astro';
import ProfilNav from '../../components/profil/ProfilNav.astro';
import { getCollection } from 'astro:content';
import { getPath } from '../../utils/links';

const halamanStatis = await getCollection('halaman-statis');
const lokasiPage = halamanStatis.find((page) => page.data.tipe === 'profil-lokasi');

const title = lokasiPage?.data.judul || 'Lokasi Desa';
const lat = lokasiPage?.data.lokasi_lat;
const lng = lokasiPage?.data.lokasi_lng;
const label = lokasiPage?.data.lokasi_label || 'Lokasi Desa Makmurjaya';

const Content = lokasiPage ? (await lokasiPage.render()).Content : null;
---

<BaseLayout
  title="Lokasi Desa Makmurjaya"
  description="Lokasi dan peta Desa Makmurjaya."
>
  <div class="page-header">
    <div class="max-w-7xl mx-auto">
      <p class="eyebrow text-gold-300 mb-1">Tentang Desa</p>
      <h1 class="font-display font-semibold text-2xl md:text-[32px] text-white">Profil Desa Makmurjaya</h1>
      <p class="text-sm text-white/60 mt-1">Kec. Jayakerta, Kab. Karawang, Jawa Barat</p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 md:px-8 py-8">
    <ProfilNav currentPath={getPath('/profil/lokasi')} />

    <article class="space-y-6 mt-6">
      <h2 class="font-display font-semibold text-xl text-ink">{title}</h2>

      {lat && lng ? (
        <section aria-labelledby="peta-heading">
          <h3 id="peta-heading" class="sr-only">Peta Lokasi Desa</h3>
          <PetaKantor lat={lat} lng={lng} label={label} zoom={15} />
        </section>
      ) : (
        <div class="rounded-2xl bg-primary-50 p-6 text-center text-muted">
          <p>Data koordinat lokasi belum tersedia.</p>
        </div>
      )}

      {Content && (
        <div class="prose prose-green max-w-none text-ink leading-relaxed">
          <Content />
        </div>
      )}
    </article>
  </div>
</BaseLayout>
