---
/**
 * Halaman Daftar Wisata — matching Figma hi-fi design.
 * Validates: Requirements 6.1
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WisataCard from '../../components/wisata/WisataCard.astro';
import { getPath } from '../../utils/links';

const allWisata = await getCollection('wisata');
---

<BaseLayout
  title="Wisata Desa — Desa Makmurjaya"
  description="Daftar destinasi wisata desa Makmurjaya yang menarik untuk dikunjungi."
>
  <section class="page-header">
    <div class="max-w-7xl mx-auto">
      <p class="eyebrow text-gold-300 mb-1">Pariwisata</p>
      <h1 class="font-display font-semibold text-2xl md:text-[32px] text-white">Wisata Desa</h1>
      <p class="text-sm text-white/60 mt-1">Destinasi wisata menarik di Desa Makmurjaya.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-8">
    {allWisata.length === 0 ? (
      <div class="empty-state">
        <svg class="w-8 h-8 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <p class="text-sm text-muted">Belum ada destinasi wisata yang dipublikasikan.</p>
      </div>
    ) : (
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {allWisata.map((wisata) => (
          <WisataCard
            nama={wisata.data.nama}
            slug={wisata.slug}
            deskripsi_singkat={wisata.data.deskripsi_singkat}
            foto_utama={wisata.data.foto_utama}
          />
        ))}
      </div>
    )}
  </div>
</BaseLayout>
