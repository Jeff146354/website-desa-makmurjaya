---
/**
 * Halaman Kontak — matching Figma hi-fi design.
 * Validates: Requirements 9.1, 9.2, 9.3, 9.4, 9.5, 9.6
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PetaKantor from '../components/kontak/PetaKantor.astro';
import KontakForm from '../components/kontak/KontakForm.astro';
import { getPath } from '../utils/links';
import situs from '../data/situs.json';

const halamanStatis = await getCollection('halaman-statis');
const kontakInfo = halamanStatis.find((item) => item.data.tipe === 'kontak-info');

const lat = kontakInfo?.data.lokasi_lat ?? situs.koordinat_lat;
const lng = kontakInfo?.data.lokasi_lng ?? situs.koordinat_lng;
const label = kontakInfo?.data.lokasi_label ?? 'Kantor ' + situs.nama_desa;
---

<BaseLayout
  title="Kontak — Desa Makmurjaya"
  description="Hubungi Kantor Desa Makmurjaya. Informasi alamat, telepon, email, jam layanan, dan formulir kontak."
>
  <section class="page-header">
    <div class="max-w-7xl mx-auto">
      <p class="eyebrow text-gold-300 mb-1">Layanan</p>
      <h1 class="font-display font-semibold text-2xl md:text-[32px] text-white">Hubungi Kami</h1>
      <p class="text-sm text-white/60 mt-1">Informasi kontak dan formulir pesan untuk Kantor Desa Makmurjaya.</p>
    </div>
  </section>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-8">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-12">
      <!-- Informasi Kontak -->
      <section aria-labelledby="info-kontak-heading">
        <h2 id="info-kontak-heading" class="font-display font-semibold text-lg text-ink mb-4">Informasi Kontak</h2>
        <div class="space-y-4">
          <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-primary-700 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            <div>
              <p class="font-medium text-ink text-sm">Alamat</p>
              <p class="text-muted text-sm">{situs.alamat}</p>
            </div>
          </div>
          <div class="flex items-start gap-3">
            <svg class="h-5 w-5 text-primary-700 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
              <p class="font-medium text-ink text-sm">Jam Layanan</p>
              <div class="text-muted text-sm space-y-0.5">
                <p>{situs.jam_layanan}</p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Peta Lokasi -->
      <section aria-labelledby="peta-lokasi-heading">
        <h2 id="peta-lokasi-heading" class="font-display font-semibold text-lg text-ink mb-4">Lokasi Kantor Desa</h2>
        <PetaKantor lat={lat} lng={lng} label={label} />
      </section>
    </div>

    <!-- Formulir Kontak -->
    <section aria-labelledby="form-kontak-heading" class="max-w-2xl">
      <h2 id="form-kontak-heading" class="font-display font-semibold text-lg text-ink mb-4">Kirim Pesan</h2>
      <p class="text-muted text-sm mb-6">Silakan isi formulir di bawah ini. Kolom bertanda <span class="text-red-600">*</span> wajib diisi.</p>
      <KontakForm />
    </section>
  </div>
</BaseLayout>
