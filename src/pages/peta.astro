---
/**
 * Peta Desa — interactive map page with points of interest.
 * Matches Figma desktop-hifi/03-listing-peta-desa.html
 * Leaflet.js + OpenStreetMap tiles.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPath } from '../utils/links';

const seoTitle = 'Peta Desa — Desa Makmurjaya';
const seoDescription = 'Peta interaktif Desa Makmurjaya. Temukan titik-titik penting di wilayah desa.';

// Coordinates for Desa Makmurjaya (Jayakerta, Karawang)
const defaultLat = -6.3665;
const defaultLng = 107.3055;
---

<BaseLayout title={seoTitle} description={seoDescription}>
  <div class="page-header">
    <div class="max-w-7xl mx-auto">
      <p class="eyebrow text-gold-300 mb-1">Peta Desa</p>
      <h1 class="font-display font-semibold text-2xl md:text-[32px] text-white">Peta Desa Makmurjaya</h1>
      <p class="text-sm text-white/60 mt-1">Temukan titik-titik penting di wilayah Desa Makmurjaya.</p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 md:px-8 py-8">
    <!-- Controls -->
    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 mb-5">
      <div class="flex-1 flex items-center gap-2 border border-line rounded-xl px-4 py-2.5 bg-white max-w-sm">
        <svg class="w-4 h-4 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
        <input
          id="peta-search"
          type="search"
          placeholder="Telusuri peta..."
          class="flex-1 text-sm text-ink placeholder:text-muted bg-transparent border-none outline-none"
          aria-label="Telusuri peta"
        />
      </div>
      <div class="flex gap-2">
        <button id="btn-peta" class="btn-outline !py-2 !px-3 text-xs" aria-pressed="true">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7" /></svg>
          Peta
        </button>
        <button id="btn-satelit" class="btn-outline !py-2 !px-3 text-xs">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          Satelit
        </button>
      </div>
    </div>

    <!-- Map container -->
    <div
      id="peta-desa"
      class="w-full h-[350px] sm:h-[420px] md:h-[520px] rounded-2xl border border-line overflow-hidden bg-primary-50"
      role="application"
      aria-label="Peta interaktif Desa Makmurjaya"
      data-lat={defaultLat}
      data-lng={defaultLng}
    >
      <noscript>
        <div class="flex items-center justify-center h-full text-center p-8">
          <p class="text-muted">
            Peta memerlukan JavaScript.
            <a
              href={`https://www.openstreetmap.org/?mlat=${defaultLat}&mlon=${defaultLng}#map=15/${defaultLat}/${defaultLng}`}
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary-700 underline"
            >
              Lihat di OpenStreetMap →
            </a>
          </p>
        </div>
      </noscript>
    </div>

    <!-- Legend -->
    <div class="flex flex-wrap items-center gap-4 md:gap-6 mt-4 text-sm text-muted">
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-primary-700"></span>Pemerintahan</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-gold-500"></span>Kesehatan</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-blue-500"></span>Pendidikan</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-green-500"></span>Wisata</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-orange-500"></span>UMKM</span>
    </div>

    <!-- Info note -->
    <div class="mt-6 card p-4 flex items-start gap-3">
      <svg class="w-5 h-5 text-primary-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      <div>
        <p class="text-sm text-ink font-medium">Titik lokasi akan diperbarui</p>
        <p class="text-xs text-muted mt-0.5">Titik-titik penting seperti fasilitas umum, tempat wisata, dan UMKM akan ditambahkan secara bertahap melalui CMS.</p>
      </div>
    </div>
  </div>
</BaseLayout>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<script>
  async function initPetaDesa() {
    const mapEl = document.getElementById('peta-desa');
    if (!mapEl) return;

    const lat = parseFloat(mapEl.dataset.lat || '-6.3665');
    const lng = parseFloat(mapEl.dataset.lng || '107.3055');

    const L = await import('leaflet');

    const osmLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      maxZoom: 19,
    });

    const satelitLayer = L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}', {
      attribution: '© Esri',
      maxZoom: 19,
    });

    const map = L.map(mapEl, { layers: [osmLayer] }).setView([lat, lng], 15);

    // Kantor Desa marker
    L.marker([lat, lng])
      .addTo(map)
      .bindPopup('<strong>Kantor Desa Makmurjaya</strong><br/>Jln. Raya Bendajaya No. 288')
      .openPopup();

    // Layer switching
    const btnPeta = document.getElementById('btn-peta');
    const btnSatelit = document.getElementById('btn-satelit');

    btnPeta?.addEventListener('click', () => {
      map.removeLayer(satelitLayer);
      map.addLayer(osmLayer);
      btnPeta.setAttribute('aria-pressed', 'true');
      btnSatelit?.setAttribute('aria-pressed', 'false');
    });

    btnSatelit?.addEventListener('click', () => {
      map.removeLayer(osmLayer);
      map.addLayer(satelitLayer);
      btnSatelit.setAttribute('aria-pressed', 'true');
      btnPeta?.setAttribute('aria-pressed', 'false');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPetaDesa);
  } else {
    initPetaDesa();
  }
</script>
