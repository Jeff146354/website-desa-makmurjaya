---
/**
 * BeritaCard.astro
 * Card component matching Figma hi-fi design — image area, title, date, cuplikan.
 *
 * Validates: Requirements 4.1, 4.2
 */
import { Image } from 'astro:assets';
import { formatTanggalIndonesia } from '../../utils/date';
import { getPath } from '../../utils/links';

interface Props {
  judul: string;
  tanggal: Date;
  foto_thumbnail?: ImageMetadata;
  cuplikan?: string;
  slug: string;
}

const { judul, tanggal, foto_thumbnail, cuplikan, slug } = Astro.props;
---

<article class="card hover:shadow-elevated transition">
  <a
    href={getPath(`/berita/${slug}`)}
    class="block min-h-[44px] group focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 rounded-2xl"
    aria-label={`Baca berita: ${judul}`}
  >
    {/* Image area */}
    <div class="aspect-video w-full overflow-hidden bg-primary-50">
      {foto_thumbnail ? (
        <Image
          src={foto_thumbnail}
          alt={judul}
          width={400}
          format="webp"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-primary-300" aria-hidden="true">
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
          </svg>
        </div>
      )}
    </div>

    {/* Content */}
    <div class="p-4">
      <h3 class="font-display font-semibold text-sm text-ink leading-snug group-hover:text-primary-700 transition-colors line-clamp-2">
        {judul}
      </h3>

      <div class="flex items-center gap-1.5 text-[11px] text-muted mt-2">
        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
        <time datetime={tanggal.toISOString()}>
          {formatTanggalIndonesia(tanggal)}
        </time>
      </div>

      {cuplikan && (
        <p class="mt-2 text-xs text-muted line-clamp-2">
          {cuplikan}
        </p>
      )}
    </div>
  </a>
</article>
